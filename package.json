{
  "name": "possiblecooker-guide",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/build-offline.mjs",
    "release:build": "tsc --noEmit && node scripts/release-vite-build.mjs && node scripts/prepare-public-release.mjs && node scripts/build-offline.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test:public-release": "node tests/public-release-check.cjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
